# Copy to .env (local run) or docker/.env (docker compose) and fill in.
# Keys: Sonarr/Radarr -> Settings -> General -> API Key.
SONARR_URL=http://sonarr:8989
SONARR_KEY=
RADARR_URL=http://radarr:7878
RADARR_KEY=
# More instances: any SONARR_<NAME>_URL/_KEY or RADARR_<NAME>_URL/_KEY pair, e.g. a 4K Radarr.
# Movies in several Radarrs are merged by TMDB id.
#RADARR_4K_URL=http://radarr-4k:7878
#RADARR_4K_KEY=

# Show a Letterboxd member's star ratings and reviews on matching titles (public RSS feed).
#LETTERBOXD_USER=yourname
#REVIEWER_NAME=Sam

#TZ=Australia/Melbourne
#SITE_TITLE=Now Showing
#REQUEST_URL=https://requests.example.com
#DAYS_AHEAD=14
#DAYS_BACK=14
#REFRESH_MINUTES=15
#NOWSHOWING_PORT=8077
